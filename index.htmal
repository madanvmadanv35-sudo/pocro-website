<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>POCRO — Build What Moves Industry</title>

<meta name="description"
content="POCRO — Industrial technology, automation and intelligent products.">

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{
    font-family:Arial,Helvetica,sans-serif;
    background:#050505;
    color:#fff;
    overflow-x:hidden;
}

a{
    text-decoration:none;
    color:inherit;
}

/* ---------------- NAVBAR ---------------- */

nav{
    position:fixed;
    top:0;
    left:0;
    width:100%;
    height:76px;
    padding:0 6%;
    display:flex;
    align-items:center;
    justify-content:space-between;
    z-index:1000;
    background:rgba(5,5,5,.65);
    backdrop-filter:blur(18px);
    border-bottom:1px solid rgba(255,255,255,.07);
}

.logo{
    font-size:25px;
    font-weight:900;
    letter-spacing:5px;
}

.logo span{
    color:#ff641f;
}

.navlinks{
    display:flex;
    gap:35px;
    align-items:center;
}

.navlinks a{
    color:#aaa;
    font-size:14px;
    transition:.3s;
}

.navlinks a:hover{
    color:#fff;
}

.navbutton{
    padding:11px 20px;
    border:1px solid #ff641f;
    border-radius:100px;
    color:#ff641f !important;
}

/* ---------------- HERO ---------------- */

.hero{
    min-height:100vh;
    position:relative;
    display:flex;
    align-items:center;
    padding:130px 7% 80px;
    overflow:hidden;
    background:
    radial-gradient(circle at 75% 45%,rgba(255,100,31,.16),transparent 28%),
    radial-gradient(circle at 15% 80%,rgba(255,255,255,.05),transparent 25%),
    #050505;
}

.grid{
    position:absolute;
    inset:0;
    opacity:.12;
    background-image:
    linear-gradient(rgba(255,255,255,.15) 1px,transparent 1px),
    linear-gradient(90deg,rgba(255,255,255,.15) 1px,transparent 1px);
    background-size:60px 60px;
    mask-image:linear-gradient(to bottom,black,transparent);
}

.hero-content{
    position:relative;
    z-index:3;
    max-width:900px;
}

.smalltitle{
    color:#ff641f;
    letter-spacing:4px;
    font-size:12px;
    text-transform:uppercase;
    margin-bottom:25px;
}

.hero h1{
    font-size:clamp(65px,10vw,145px);
    line-height:.84;
    letter-spacing:-7px;
    font-weight:900;
}

.hero h1 span{
    color:#ff641f;
}

.hero-text{
    max-width:620px;
    color:#aaa;
    font-size:18px;
    line-height:1.7;
    margin-top:35px;
}

.buttons{
    display:flex;
    gap:15px;
    margin-top:40px;
    flex-wrap:wrap;
}

.btn{
    padding:15px 27px;
    border-radius:100px;
    font-weight:bold;
    transition:.3s;
}

.primary{
    background:#ff641f;
    color:#050505;
}

.primary:hover{
    transform:translateY(-4px);
    box-shadow:0 12px 35px rgba(255,100,31,.25);
}

.secondary{
    border:1px solid #444;
    color:#ddd;
}

.secondary:hover{
    border-color:#fff;
}

/* ---------------- ORBIT ---------------- */

.orbit{
    position:absolute;
    right:8%;
    top:50%;
    transform:translateY(-50%);
    width:390px;
    height:390px;
    border:1px solid rgba(255,100,31,.3);
    border-radius:50%;
    animation:rotate 18s linear infinite;
}

.orbit:before{
    content:"";
    position:absolute;
    inset:45px;
    border:1px solid rgba(255,255,255,.12);
    border-radius:50%;
}

.orbit:after{
    content:"POCRO";
    position:absolute;
    inset:0;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:30px;
    font-weight:900;
    letter-spacing:8px;
    color:#fff;
}

.dot{
    position:absolute;
    width:13px;
    height:13px;
    border-radius:50%;
    background:#ff641f;
    box-shadow:0 0 25px #ff641f;
    top:18px;
    left:50%;
}

@keyframes rotate{
    from{transform:translateY(-50%) rotate(0deg);}
    to{transform:translateY(-50%) rotate(360deg);}
}

/* ---------------- SECTION ---------------- */

section{
    padding:120px 7%;
}

.label{
    color:#ff641f;
    font-size:12px;
    letter-spacing:4px;
    text-transform:uppercase;
    margin-bottom:20px;
}

.title{
    font-size:clamp(42px,6vw,80px);
    line-height:.95;
    letter-spacing:-3px;
    max-width:900px;
}

/* ---------------- CARDS ---------------- */

.products{
    background:#f2f0eb;
    color:#080808;
}

.product-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:2px;
    margin-top:60px;
    background:#111;
}

.product{
    min-height:330px;
    padding:38px;
    background:#f2f0eb;
    position:relative;
    overflow:hidden;
    transition:.4s;
}

.product:hover{
    background:#ff641f;
    transform:translateY(-8px);
}

.product-number{
    font-size:13px;
    color:#777;
}

.product h3{
    font-size:32px;
    margin-top:100px;
}

.product p{
    margin-top:12px;
    color:#666;
    max-width:300px;
}

.product:hover p{
    color:#222;
}

/* ---------------- NETWORK ---------------- */

.network{
    background:#090909;
}

.network-intro{
    color:#999;
    max-width:650px;
    margin-top:25px;
    font-size:18px;
}

.flow{
    margin-top:70px;
    display:grid;
    grid-template-columns:1fr auto 1fr auto 1fr;
    align-items:center;
    gap:18px;
}

.flowcard{
    min-height:210px;
    border:1px solid #292929;
    padding:35px;
    background:linear-gradient(145deg,#101010,#080808);
    transition:.3s;
}

.flowcard:hover{
    border-color:#ff641f;
    transform:translateY(-6px);
}

.flowcard small{
    color:#ff641f;
    letter-spacing:2px;
}

.flowcard h3{
    margin-top:25px;
    font-size:25px;
}

.arrow{
    color:#ff641f;
    font-size:35px;
}

/* ---------------- VISION ---------------- */

.vision{
    min-height:75vh;
    display:flex;
    align-items:center;
    background:
    radial-gradient(circle at 50% 50%,rgba(255,100,31,.12),transparent 35%),
    #ff641f;
    color:#080808;
}

.vision .label{
    color:#080808;
}

.vision h2{
    font-size:clamp(55px,8vw,115px);
    line-height:.85;
    letter-spacing:-6px;
    max-width:1100px;
}

.vision p{
    max-width:500px;
    margin-top:35px;
    font-size:18px;
}

/* ---------------- CONTACT ---------------- */

.contact{
    text-align:center;
    min-height:70vh;
    display:flex;
    flex-direction:column;
    justify-content:center;
    align-items:center;
}

.contact h2{
    font-size:clamp(55px,9vw,120px);
    letter-spacing:-6px;
}

.contact p{
    color:#999;
    max-width:550px;
    margin:25px auto 35px;
    font-size:18px;
}

.email{
    color:#ff641f;
    font-size:19px;
    border-bottom:1px solid #ff641f;
    padding-bottom:5px;
}

/* ---------------- FOOTER ---------------- */

footer{
    padding:30px 7%;
    border-top:1px solid #222;
    display:flex;
    justify-content:space-between;
    color:#666;
    font-size:13px;
}

/* ---------------- MOBILE ---------------- */

@media(max-width:850px){

    .navlinks{
        display:none;
    }

    .hero{
        padding:130px 7% 80px;
    }

    .hero h1{
        letter-spacing:-4px;
    }

    .orbit{
        opacity:.18;
        width:330px;
        height:330px;
        right:-120px;
    }

    section{
        padding:85px 7%;
    }

    .product-grid{
        grid-template-columns:1fr;
    }

    .flow{
        grid-template-columns:1fr;
    }

    .arrow{
        text-align:center;
        transform:rotate(90deg);
    }

    .vision h2{
        letter-spacing:-4px;
    }

    footer{
        flex-direction:column;
        gap:10px;
    }
}
</style>
</head>

<body>

<!-- NAVIGATION -->

<nav>

    <div class="logo">
        POC<span>RO</span>
    </div>

    <div class="navlinks">
        <a href="#products">Products</a>
        <a href="#network">Network</a>
        <a href="#vision">Vision</a>
        <a href="#contact" class="navbutton">Contact</a>
    </div>

</nav>


<!-- HERO -->

<header class="hero">

    <div class="grid"></div>

    <div class="hero-content">

        <div class="smalltitle">
            Industrial Technology • Automation • Innovation
        </div>

        <h1>
            BUILD.<br>
            CONNECT.<br>
            <span>MOVE.</span>
        </h1>

        <p class="hero-text">
            POCRO is building a new way to discover industrial
            technology — connecting customers, products and
            industries through one growing technology network.
        </p>

        <div class="buttons">

            <a href="#products" class="btn primary">
                Explore POCRO →
            </a>

            <a href="#network" class="btn secondary">
                How it works
            </a>

        </div>

    </div>

    <div class="orbit">
        <div class="dot"></div>
    </div>

</header>


<!-- PRODUCTS -->

<section class="products" id="products">

    <div class="label">
        01 / Technology
    </div>

    <h2 class="title">
        The technology behind tomorrow's industry.
    </h2>

    <div class="product-grid">

        <div class="product">

            <div class="product-number">
                01
            </div>

            <h3>
                Industrial Equipment
            </h3>

            <p>
                Equipment and technology designed for
                modern industrial applications.
            </p>

        </div>


        <div class="product">

            <div class="product-number">
                02
            </div>

            <h3>
                Automation
            </h3>

            <p>
                Controllers, sensors, motors and
                automation components.
            </p>

        </div>


        <div class="product">

            <div class="product-number">
                03
            </div>

            <h3>
                Electronics
            </h3>

            <p>
                Microcontrollers and electronic
                technologies for engineers and builders.
            </p>

        </div>

    </div>

</section>


<!-- NETWORK -->

<section class="network" id="network">

    <div class="label">
        02 / POCRO Network
    </div>

    <h2 class="title">
        From requirement<br>
        to solution.
    </h2>

    <p class="network-intro">
        POCRO aims to connect the people who need technology
        with the industries and suppliers that can provide it.
    </p>


    <div class="flow">

        <div class="flowcard">

            <small>
                01 / CUSTOMER
            </small>

            <h3>
                I need a product.
            </h3>

        </div>


        <div class="arrow">
            →
        </div>


        <div class="flowcard">

            <small>
                02 / POCRO
            </small>

            <h3>
                We find the connection.
            </h3>

        </div>


        <div class="arrow">
            →
        </div>


        <div class="flowcard">

            <small>
                03 / INDUSTRY
            </small>

            <h3>
                The solution moves.
            </h3>

        </div>

    </div>

</section>


<!-- VISION -->

<section class="vision" id="vision">

    <div>

        <div class="label">
            03 / The Future
        </div>

        <h2>
            START WITH<br>
            PRODUCTS.<br>
            BUILD THE<br>
            NETWORK.
        </h2>

        <p>
            POCRO begins with industrial technology.
            The long-term vision is to develop original
            products, automation systems and intelligent
            technology for industry.
        </p>

    </div>

</section>


<!-- CONTACT -->

<section class="contact" id="contact">

    <div class="label">
        04 / Connect
    </div>

    <h2>
        LET'S BUILD.
    </h2>

    <p>
        Have an industrial requirement, product enquiry
        or technology idea?
    </p>

    <a class="email" href="mailto:pocro.contact@gmail.com">
        pocro.contact@gmail.com
    </a>

</section>


<!-- FOOTER -->

<footer>

    <div>
        © 2026 POCRO
    </div>

    <div>
        Industrial Technology Network
    </div>

</footer>


</body>
  </html>
